{
  "name": "cloudbytelabs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "dev:api": "tsx watch backend/src/server.ts",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts && node scripts/seo.mjs",
    "start": "tsx backend/src/server.ts",
    "test": "tsx --test backend/src/api.test.ts",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "framer-motion": "^12.23.0",
    "gsap": "^3.15.1",
    "helmet": "^8.1.0",
    "i18next": "^25.5.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.20.0",
    "nodemailer": "^10.0.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.0",
    "react-router-dom": "^7.9.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.187.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
